PORT=8080
HOST=127.0.0.1
DATABASE_URL="file:./data/dev.db"
AUTH_TOKEN_SECRET=change-this-local-dev-secret
AUTH_TOKEN_TTL_SECONDS=2592000

APOLLO_API_PORT=47990
APOLLO_API_USERNAME=
APOLLO_API_PASSWORD=
APOLLO_API_REJECT_UNAUTHORIZED=false
APOLLO_API_USE_PRIVATE_IP=false

AWS_REGION=ap-south-1
AWS_PROFILE=default

AWS_AMI_ID=ami-04fe85ad48985c7e7
AWS_INSTANCE_TYPE=g4dn.xlarge
AWS_KEY_NAME=Gaming
AWS_SECURITY_GROUP_ID=sg-0b0cd0139dbf5796e
AWS_IAM_INSTANCE_PROFILE_NAME=ec2-nvidia-driver

# Pick one subnet in the AZ where user game volumes should live.
# If omitted, EC2 chooses a default subnet, but volume attach requires same AZ.
AWS_SUBNET_ID=
AWS_AVAILABILITY_ZONE=ap-south-1b

GAME_VOLUME_SIZE_GB=140
GAME_VOLUME_TYPE=gp3
GAME_VOLUME_DEVICE=/dev/sdf
