PORT=8080
HOST=127.0.0.1
DATABASE_URL="file:./data/dev.db"
AUTH_TOKEN_SECRET=change-this-local-dev-secret
AUTH_TOKEN_TTL_SECONDS=604800
# Set to true once the API is served over HTTPS.
COOKIE_SECURE=false

APOLLO_API_PORT=47990
APOLLO_API_USERNAME=
APOLLO_API_PASSWORD=
APOLLO_API_REJECT_UNAUTHORIZED=false
APOLLO_API_USE_PRIVATE_IP=false

AWS_REGION=ap-south-1
AWS_PROFILE=cloud-gaming

# From `terraform -chdir=infra/terraform output`. The launch template carries the
# AMI, instance type, subnet, security group and instance profile.
AWS_LAUNCH_TEMPLATE_ID=
AWS_AVAILABILITY_ZONE=ap-south-1b

GAME_VOLUME_SIZE_GB=140
GAME_VOLUME_TYPE=gp3
GAME_VOLUME_DEVICE=/dev/sdf
