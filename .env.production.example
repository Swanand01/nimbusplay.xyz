# Backend env for the EC2 host. Install with:
#   infra/scripts/deploy-backend.sh --env .env.production
# Paste the AWS_* / APOLLO_API_USE_PRIVATE_IP lines from `terraform -chdir=infra/terraform output -raw backend_env`.
# No AWS_PROFILE or access keys: the backend uses its instance role.
# No secrets here: AUTH_TOKEN_SECRET and APOLLO_API_PASSWORD live in SSM Parameter
# Store (/cloud-gaming/auth-token-secret, /cloud-gaming/apollo-api-password) and are
# added on the host by deploy-backend.sh.

PORT=8080
HOST=0.0.0.0
DATABASE_URL="file:/opt/cloud-gaming/data/prod.db"
AUTH_TOKEN_TTL_SECONDS=2592000

APOLLO_API_PORT=47990
APOLLO_API_USERNAME=apollo
APOLLO_API_REJECT_UNAUTHORIZED=false
APOLLO_API_USE_PRIVATE_IP=true

AWS_REGION=ap-south-1
AWS_AVAILABILITY_ZONE=ap-south-1b
AWS_LAUNCH_TEMPLATE_ID=

GAME_VOLUME_SIZE_GB=140
GAME_VOLUME_TYPE=gp3
GAME_VOLUME_DEVICE=/dev/sdf
